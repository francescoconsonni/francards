{
  "manifest_version": 3,
  "name": "Francards",
  "version": "0.2.0",
  "description": "Captura a questão que você errou (medcof e outros sites) e gera flashcards direto no popup via IA — sem abrir nova aba.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Criar flashcard desta questão"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://francards.vercel.app/*",
    "http://localhost:5000/*",
    "http://localhost/*",
    "http://127.0.0.1:8765/*",
    "https://*.ts.net/*"
  ],
  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
